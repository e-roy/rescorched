# Exact version pins only — no `^` or `~` ranges. See TECH_STACK.md.
save-exact=true

# Keep the workspace honest: a dependency on another workspace package must be
# declared, and resolves from the workspace rather than the registry.
link-workspace-packages=true
prefer-workspace-packages=true

# Fail loudly rather than silently hoisting: every import must come from a
# declared dependency.
strict-peer-dependencies=false
auto-install-peers=false
