{
  "name": "@scorched/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas and TypeScript types for every client<->server WebSocket message",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@scorched/config": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "@scorched/sim": "workspace:*"
  }
}
